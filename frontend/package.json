{
  "name": "inquira",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:source && npm run test:runtime",
    "test:source": "node --test test/*.test.mjs",
    "test:runtime": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "bundle:report": "node scripts/bundle-report.mjs",
    "bundle:baseline": "npm run build && npm run bundle:report -- --output baselines/frontend-bundle-baseline.json",
    "bundle:check": "npm run build && npm run bundle:report && node scripts/check-bundle-budget.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.1",
    "@heroicons/vue": "^2.2.0",
    "@tailwindcss/vite": "^4.1.11",
    "@tanstack/vue-table": "^8.21.3",
    "@vscode/markdown-it-katex": "^1.1.2",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.11",
    "katex": "^0.16.11",
    "markdown-it": "^14.1.0",
    "pinia": "^3.0.3",
    "plotly.js-dist-min": "^3.0.3",
    "prismjs": "^1.30.0",
    "reka-ui": "^2.10.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.11",
    "vue": "^3.5.17"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.11",
    "axe-core": "^4.12.1",
    "happy-dom": "^20.10.2",
    "typescript": "^7.0.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "vue-tsc": "^3.3.8"
  },
  "overrides": {
    "@codemirror/matchbrackets": "npm:@codemirror/language",
    "@codemirror/rangeset": "npm:@codemirror/state",
    "@codemirror/text": "npm:@codemirror/state",
    "brace-expansion": "^5.0.9",
    "glob": "^12.0.0",
    "js-beautify": "^2.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true,
    "vue-demi@0.14.10": true
  }
}
